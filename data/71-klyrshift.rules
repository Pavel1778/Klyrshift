# Klyrshift udev rules.
#
# Access is granted with TAG+="uaccess" rather than by adding the user to the
# "input" group. uaccess gives a POSIX ACL to the user who is physically logged
# in at the seat (the active session), dynamically and only for that user. It
# needs no usermod and no relogin, and it is revoked when the session ends.
#
# The file is named 71-* on purpose. The systemd/udev shipped rule that applies
# uaccess ACLs for input devices is 73-seat-late.rules on systemd 257+ (Debian
# 13); a 99-* rule runs after it, so the ACL is never applied. Installing the
# rule earlier (71) lets 73-seat-late.rules pick up the tag. ACTION!="remove"
# keeps the tag on the "remove" event from being (re)applied while the device
# is going away.
#
# Installed to /usr/lib/udev/rules.d/ by the package; run
#   sudo udevadm control --reload-rules && sudo udevadm trigger
# after editing.

# Read access to keyboard event devices for the active session user. Only
# keyboards: the daemon reads nothing else, so the mouse, touchpad, joysticks
# and other input devices stay closed to other processes of the session.
# ID_INPUT_KEYBOARD is set earlier by 60-input-id.rules.
ACTION!="remove", KERNEL=="event*", ENV{ID_INPUT_KEYBOARD}=="1", TAG+="uaccess"

# Klyrshift's own virtual keyboards. They declare only the keys they emit, so
# udev may not classify them as keyboards; without read access python-evdev
# waits ~2 s for every device it creates. They carry only what Klyrshift itself
# types, so reading them exposes nothing new.
ACTION!="remove", KERNEL=="event*", ATTRS{name}=="klyrshift*", TAG+="uaccess"

# Write access to the virtual keyboard used to rewrite text. static_node creates
# /dev/uinput on boot when the uinput module is already loaded.
ACTION!="remove", KERNEL=="uinput", TAG+="uaccess", OPTIONS+="static_node=uinput"
