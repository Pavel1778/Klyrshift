#compdef klyrshift
# Zsh completion for klyrshift. Generated by scripts/build_cli_docs.py.
# Install as /usr/share/zsh/vendor-completions/_klyrshift.

_klyrshift() {
    local -a commands
    commands=(
        'app-mode:show or set the mode for one application'
        'collect-logs:collect a diagnostic archive for an issue'
        'config:work with the configuration'
        'dict:dictionary of words not to correct'
        'doctor:environment self-diagnostics'
        'explain:explain the detector decision for a word (read-only)'
        'export:save settings to a file (JSON)'
        'fix:correct the text manually'
        'gui:open the graphical interface (GTK4)'
        'hotkeys:show the active hotkeys'
        'import:restore settings from a file (JSON)'
        'install-autostart:enable autostart'
        'kill:force-kill a hung daemon (SIGKILL)'
        'learn:learning: statistics, word list, on/off'
        'logs:show the daemon log'
        'mode:show or change the mode (auto/manual/hybrid)'
        'restart:restart the daemon'
        'start:start the daemon'
        'status:show the status'
        'stop:stop the daemon'
        'undo:undo the last correction'
        'uninstall-autostart:disable autostart'
        'verify:check the file integrity of the installed package'
        'version:show the version'
    )
    _arguments -C \
        '--version[print the version]' \
        '--lang[output language]:locale:(auto ru en de fr uk)' \
        '1: :->cmd' \
        '*:: :->args'
    case $state in
        cmd)
            _describe 'command' commands
            ;;
        args)
            case $words[1] in
            app-mode)
                _arguments \
                '--clear[remove the application from the list]' \
                '1: :(auto manual hybrid)'
                ;;
            collect-logs)
                _arguments \
                '--output[directory for the archive (defaults to the home directory)]:DIR:'
                ;;
            config)
                _arguments \
                '--dry-run[for migrate: show the changes without writing anything]' \
                '1: :(show edit reset path migrate)'
                ;;
            dict)
                _arguments \
                '--lang[language for import-file/pack when it is not in the file name]:locale:(auto ru en de fr uk)' \
                '--file[additional file for dict pack]' \
                '--name[package name for dict pack]' \
                '--kind[package kind for dict pack]' \
                '--output[where to write the package (dict pack)]' \
                '--package-version[package version (dict pack)]' \
                '--license[package license (dict pack)]' \
                '1: :(list add remove download import-file categories install list-installed remove-category pack verify install-file uninstall-file)'
                ;;
            doctor)
                _arguments \
                '*: :_default'
                ;;
            explain)
                _arguments \
                '--text[text to analyze (otherwise read from stdin)]' \
                '--layout[current layout (otherwise detected)]'
                ;;
            export)
                _arguments \
                '*: :_default'
                ;;
            fix)
                _arguments \
                '--text[text to correct (otherwise read from stdin)]' \
                '--apply[apply the correction on screen]' \
                '--dry-run[only show the correction without applying anything]'
                ;;
            gui)
                _arguments \
                '*: :_default'
                ;;
            hotkeys)
                _arguments \
                '*: :_default'
                ;;
            import)
                _arguments \
                '*: :_default'
                ;;
            install-autostart)
                _arguments \
                '*: :_default'
                ;;
            kill)
                _arguments \
                '*: :_default'
                ;;
            learn)
                _arguments \
                '--on[enable learning]' \
                '--off[disable learning]' \
                '--reset[reset the learning counters]' \
                '1: :(list promote forget)'
                ;;
            logs)
                _arguments \
                '-n --lines[how many recent lines to show (50 by default)]:N:' \
                '-f --follow[follow the log in real time]' \
                '--level[show only lines of this level (DEBUG/INFO/WARNING/ERROR)]:LEVEL:'
                ;;
            mode)
                _arguments \
                '1: :(auto manual hybrid)'
                ;;
            restart)
                _arguments \
                '*: :_default'
                ;;
            start)
                _arguments \
                '--foreground[do not detach into the background]' \
                '--dry-run[analyze without switching the layout or replacing text]'
                ;;
            status)
                _arguments \
                '*: :_default'
                ;;
            stop)
                _arguments \
                '*: :_default'
                ;;
            undo)
                _arguments \
                '*: :_default'
                ;;
            uninstall-autostart)
                _arguments \
                '*: :_default'
                ;;
            verify)
                _arguments \
                '*: :_default'
                ;;
            version)
                _arguments \
                '*: :_default'
                ;;
            esac
            ;;
    esac
}

_klyrshift "$@"
