---
import { Font } from "astro:assets";
import "../styles/global.css";
import { LAYERO_URL, VERCEL_URL, isVercel, lang, pick, siteUrl } from "../lib/site";
import { THEME_COLOR } from "../lib/theme";
import { AUTHOR_URL, LATEST_RELEASE, REPO, VERSION } from "../consts";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = pick(
    "Klyrshift — автоматическое исправление раскладки для Linux",
    "Klyrshift — automatic keyboard layout switcher for Linux",
  ),
  description = pick(
    "Klyrshift — автоматический переключатель раскладки клавиатуры для Linux. Исправляет ghbdtn → привет мгновенно. Работает в Wayland и X11, GNOME 45+, KDE, Sway. Аналог Caramba Switcher и Punto Switcher. Бесплатно, MIT, без телеметрии.",
    "Klyrshift — automatic keyboard layout switcher for Linux. Fixes ghbdtn → privet instantly. Works in Wayland and X11, GNOME 45+, KDE, Sway. Free, MIT, no telemetry.",
  ),
} = Astro.props;

// Both hosts are indexed and each declares itself canonical, so the two copies
// never compete as duplicate content. Canonical and og:url use the stable host
// origin, never the per-deployment VERCEL_URL host.
const canonical = new URL(Astro.url.pathname, siteUrl);
const ogImage = new URL("/og-image.png", siteUrl);

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Klyrshift",
  description: pick(
    "Автоматический переключатель раскладки клавиатуры для Linux",
    "Automatic keyboard layout switcher for Linux",
  ),
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Linux",
  softwareVersion: VERSION,
  license: "https://opensource.org/licenses/MIT",
  url: siteUrl,
  downloadUrl: LATEST_RELEASE,
  codeRepository: REPO,
  author: {
    "@type": "Person",
    name: "Pavel",
    url: AUTHOR_URL,
  },
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />

    <link rel="alternate" hreflang="ru" href={LAYERO_URL + "/"} />
    <link rel="alternate" hreflang="en" href={VERCEL_URL + "/"} />
    <link rel="alternate" hreflang="x-default" href={LAYERO_URL + "/"} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Klyrshift" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={isVercel ? "en_US" : "ru_RU"} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- One theme-color, set by the pre-paint script below. A pair of
         `media="(prefers-color-scheme: ...)"` metas cannot follow an explicit
         choice: when the visitor picks the theme opposite to their system, the
         matching meta still wins and the browser chrome keeps the wrong colour. -->
    <meta name="theme-color" content={THEME_COLOR.light} />

    <script is:inline define:vars={{ THEME_COLOR }}>
      // Runs before first paint: pick the saved theme, else the system one, and
      // set `.dark` on <html>. Without this the page flashes the light theme
      // before the deferred module script could correct it.
      (() => {
        try {
          const saved = localStorage.getItem("klyrshift-theme");
          const dark = saved
            ? saved === "dark"
            : window.matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.classList.toggle("dark", dark);
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute("content", dark ? THEME_COLOR.dark : THEME_COLOR.light);
        } catch {
          /* private mode / storage disabled: fall back to the light theme */
        }
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <Font cssVariable="--font-golos" preload />
    <Font cssVariable="--font-unbounded" preload />
    <Font cssVariable="--font-jetbrains" />
  </head>
  <body
    data-copy-label={pick("Копировать", "Copy")}
    data-copied-label={pick("Скопировано", "Copied")}
    data-error-label={pick("Ошибка", "Failed")}
  >
    <a class="skip-link" href="#main">{pick("Перейти к содержимому", "Skip to content")}</a>
    <slot />
  </body>
</html>
