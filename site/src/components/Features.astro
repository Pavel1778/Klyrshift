---
import { pick } from "../lib/site";

type Feature = { title: string; text: string; icon: string };

// Lucide-style 24x24 outline paths, kept inline so the page ships no icon JS.
const features: Feature[] = [
  {
    title: pick("Wayland и X11", "Wayland and X11"),
    text: pick(
      "Работает на обоих протоколах. GNOME, KDE, Sway, Hyprland.",
      "Works on both protocols. GNOME, KDE, Sway, Hyprland.",
    ),
    icon: "M3 5h18v12H3zM8 21h8M12 17v4",
  },
  {
    title: pick("Приватность", "Privacy"),
    text: pick(
      "Всё локально. Демон не делает сетевых запросов; текст не пишется в логи. Загрузка словарей — только по вашей команде.",
      "Everything is local. The daemon makes no network requests and never logs your text. Dictionaries download only when you ask.",
    ),
    icon: "M5 11V8a7 7 0 0 1 14 0v3M6 11h12v9H6zM12 15v2",
  },
  {
    title: pick("Zero-Config .deb", "Zero-config .deb"),
    text: pick(
      "apt install — и работает. Автозагрузка, права, systemd.",
      "apt install and it works: autostart, permissions, systemd.",
    ),
    icon: "M12 2c3 4 5 7 5 10a5 5 0 0 1-10 0c0-3 2-6 5-10ZM9 15l-2 5M15 15l2 5",
  },
  {
    title: pick("Умный контекст", "Smart context"),
    text: pick(
      "Смотрит на соседние слова. Не трогает URL, email, код.",
      "It reads the surrounding words and leaves URLs, email addresses and code alone.",
    ),
    icon: "M9 3a3 3 0 0 0-3 3 3 3 0 0 0-2 5 3 3 0 0 0 2 5 3 3 0 0 0 6 1V3a3 3 0 0 0-3 0ZM15 3a3 3 0 0 1 3 3 3 3 0 0 1 2 5 3 3 0 0 1-2 5 3 3 0 0 1-3 1",
  },
  {
    title: pick("Три режима", "Three modes"),
    text: pick(
      "Auto (мгновенно) / Manual (по хоткею) / Hybrid (+undo).",
      "Auto (instant) / Manual (on hotkey) / Hybrid (with undo).",
    ),
    icon: "M13 2 4 14h6l-1 8 9-12h-6z",
  },
  {
    title: pick("5 языков", "5 languages"),
    text: pick(
      "en и ru из коробки; uk, de, fr — включаются опционально.",
      "en and ru out of the box; uk, de and fr are optional.",
    ),
    icon: "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18ZM3 12h18M12 3c2.5 2.5 4 5.5 4 9s-1.5 6.5-4 9c-2.5-2.5-4-5.5-4-9s1.5-6.5 4-9Z",
  },
];
---

<section id="features" class="container-page py-16 sm:py-20">
  <h2 class="text-center text-3xl font-bold tracking-tight sm:text-4xl">
    {pick("Возможности", "Features")}
  </h2>
  <p class="mx-auto mt-4 max-w-2xl text-center text-muted">
    {pick(
      "Всё, что нужно, чтобы забыть о переключении раскладки.",
      "Everything you need to stop thinking about the keyboard layout.",
    )}
  </p>

  <ul class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {features.map((f) => (
      <li class="card transition-colors hover:border-accent-line">
        <span class="icon-chip">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={f.icon} />
          </svg>
        </span>
        <h3 class="mt-4 text-lg font-semibold">{f.title}</h3>
        <p class="mt-2 text-muted">{f.text}</p>
      </li>
    ))}
  </ul>
</section>
