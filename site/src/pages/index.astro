---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Demo from "../components/Demo.astro";
import Features from "../components/Features.astro";
import Comparison from "../components/Comparison.astro";
import DictionaryDownloads from "../components/DictionaryDownloads.astro";
import Install from "../components/Install.astro";
import SystemRequirements from "../components/SystemRequirements.astro";
import Community from "../components/Community.astro";
import Faq from "../components/Faq.astro";
import Footer from "../components/Footer.astro";
import { pick } from "../lib/site";
---

<Base>
  <Header />
  <main id="main">
    <Hero />
    <HowItWorks />
    <Demo />
    <Features />
    <Comparison />
    <Install />
    <DictionaryDownloads all={false} />
    <SystemRequirements />
    <Community />
    <Faq />
  </main>
  <Footer />

  <script>
    // One listener for every copy button on the page. The labels travel in data
    // attributes so the RU host does not show the English "Copy".
    const copyLabel = document.body.dataset.copyLabel ?? "Copy";
    const copiedLabel = document.body.dataset.copiedLabel ?? "Copied";
    const errorLabel = document.body.dataset.errorLabel ?? "Failed";

    document.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach((button) => {
      const reset = button.textContent;
      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.code ?? "");
          button.textContent = copiedLabel;
        } catch {
          button.textContent = errorLabel;
        }
        window.setTimeout(() => (button.textContent = reset || copyLabel), 1500);
      });
    });
  </script>
</Base>
